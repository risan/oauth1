{
    "name": "risan/oauth1",
    "type": "library",
    "description": "OAuth 1.0 client library for PHP",
    "keywords": [
        "oauth",
        "oauth1",
        "authorization",
        "authentication",
        "twitter",
        "tumblr"
    ],
    "homepage": "https://github.com/risan/oauth1",
    "license": "MIT",
    "authors": [
        {
            "name": "Risan Bagja Pradana",
            "email": "risanbagja@gmail.com",
            "homepage": "https://risan.io",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Risan\\OAuth1\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Risan\\OAuth1\\Test\\": "tests"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-hash": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^8.2",
        "guzzlehttp/psr7": "^3.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.1",
        "phpstan/phpstan": "^2.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "format": "pint --test",
        "test": "pest"
    },
    "prefer-stable": true
}
